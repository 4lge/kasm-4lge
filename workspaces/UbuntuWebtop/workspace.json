{
  "description": "A Ubuntu KASM image with Statistics Software and more.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu.png",
  "name": "4lge/kasm-ubuntu-webtop:main",
  "run_config": {
    "hostname": "ubuntu-kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "OS"
  ],
  "friendly_name": "Ubuntu Webtop",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "4lge/kasm-ubuntu-webtop:1.17.0",
      "uncompressed_size_mb": 18400,
      "available_tags": [
        "main"
      ]
    }
  ]
}
